[ext_resource type="Script" uid="uid://byknsokd4a1h0" path="res://resources/conversation.gd" id="0"]
[ext_resource type="Script" uid="uid://c4nqgiisltlk" path="res://resources/replique_dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://blm8n7fkmbgfp" path="res://resources/personnage_dialogue.gd" id="1_7eb44"]
[ext_resource type="Script" uid="uid://dey7xqbrualto" path="res://resources/choix_dialogue.gd" id="2"]
[ext_resource type="Resource" uid="uid://dskh6uer2righ" path="res://resources/personnage_al.tres" id="3"]
[ext_resource type="Resource" uid="uid://b6s63magyw5ib" path="res://resources/personnage_jenny.tres" id="4"]

[sub_resource type="Resource" id="Choix1"]
script = ExtResource("2")
texte_a = "La dernière porte, c'est la plus chère.
J'fais pas ça pour vos beaux yeux.
Posez vot' peine et vot' fric sur le bureau."
valeur_a = -2.5
texte_b = "Épargnez-moi le numéro de la pauvre mère.
Vous vous asseyez, ou vous dégagez.
J'ai pas que ça à foutre, moi."
valeur_b = -5.0
texte_c = "... Asseyez-vous ..."

[sub_resource type="Resource" id="Rep01"]
script = ExtResource("1")
locuteur = 1
texte = "On m'a dit que vous retrouviez les gens.
Que vous étiez la dernière porte,
quand toutes les autres se referment.
Alors me voilà.
Avant de ne plus en avoir aucune."
choix = SubResource("Choix1")

[sub_resource type="Resource" id="Rep02"]
script = ExtResource("1")
locuteur = 1
reaction_a = "S'il vous plaît.
Je ne savais plus vers qui me tourner."
reaction_b = "Je vois que vous ne prenez pas de gants, vous."
reaction_c = "Vous ne dites rien.
C'est déjà plus que la police."

[sub_resource type="Resource" id="Rep03"]
script = ExtResource("1")
locuteur = 1
texte = "C'est ma fille, Luna.
Vingt-trois ans.
Plus rentrée depuis plus d'un mois.
Elle m'appelait tous les dimanches.
Sans faute, depuis qu'elle avait quitté la maison.
On parlait de tout et de rien.
La pluie, ses collègues, un film.
Et un dimanche, le téléphone n'a pas sonné.
Ni le suivant."

[sub_resource type="Resource" id="Choix2"]
script = ExtResource("2")
texte_a = "La police a bâclé ça en une après-midi.
Sinon vous seriez pas
plantée dans mon bureau."
texte_b = "Plus d'un mois, madame.
Et c'est aujourd'hui
que vous vous décidez à frapper ?"
valeur_b = -5.0
texte_c = "... Continuez ..."

[sub_resource type="Resource" id="Rep04"]
script = ExtResource("1")
locuteur = 1
texte = "Avant ça, elle avait changé.
Quelques semaines plus tôt.
Plus brève. Plus froide.
Elle qui souriait aux inconnus dans la rue.
J'ai mis ça sur le compte de la fatigue.
Ou d'un garçon, peut-être.
Je ne sais plus."
choix = SubResource("Choix2")

[sub_resource type="Resource" id="Rep05"]
script = ExtResource("1")
locuteur = 1
texte = "Ils ont noté son nom sur un papier.
Le papier dort dans un tiroir.
Voilà ce qu'ils ont fait. Rien."
reaction_a = "En une après-midi, oui.
Son nom sur un formulaire, dans un tiroir.
On m'a dit de rentrer chez moi.
Voilà leur enquête."
reaction_b = "Vous croyez que j'ai attendu ?
J'ai supplié. On m'a fait patienter,
remplir des papiers, revenir pour rien.
Une mère pauvre qui s'inquiète,
ça les fait bâiller."
reaction_c = "Ils ont noté son nom sur un papier.
Le papier est dans un tiroir.
Voilà ce qu'ils ont fait.
Rien."

[sub_resource type="Resource" id="Rep06"]
script = ExtResource("1")
texte = "Les gens changent, madame.
Et certains s'arrangent
pour qu'on les retrouve jamais."
texte_good = "Les gens changent. Mais on s'efface pas
sans laisser une trace quelque part.
Suffit de savoir où gratter."
texte_mid = "Tout le monde change.
La seule question qui tienne :
elle est partie, ou on l'a fait partir ?"
texte_bof = "On change tous, madame.
On sourit aux inconnus un matin,
et un soir on comprend pourquoi fallait pas."
texte_bad = "Les gens qui s'effacent ont leurs raisons.
Et c'est rarement
des raisons qu'une mère veut entendre."

[sub_resource type="Resource" id="Choix3"]
script = ExtResource("2")
texte_a = "Gardez vos billets, madame.
Laissez-moi la photo.
Ça suffira pour commencer."
valeur_a = 5.0
texte_b = "Vous lâcherez pas le morceau, hein.
Autant que ce soit moi
qui fouille dans votre merdier."
texte_c = "..."

[sub_resource type="Resource" id="Rep07"]
script = ExtResource("1")
locuteur = 1
texte = "Voici une photo récente d'elle.
Je n'ai pas de quoi vous payer
comme on paie un homme de votre métier.
J'ai mis de côté ce que j'ai pu.
C'est peu, je le sais."
choix = SubResource("Choix3")

[sub_resource type="Resource" id="Rep08"]
script = ExtResource("1")
locuteur = 1
texte = "Alors c'est oui ?
Merci."
reaction_a = "Vous... merci.
Je trouverai de quoi vous payer,
d'une façon ou d'une autre."
reaction_b = "S'il vous plaît. Retrouvez ma fille."
reaction_c = "Personne ne l'avait seulement regardée."

[sub_resource type="Resource" id="Rep09"]
script = ExtResource("1")
texte = "Sa chambre. Ses affaires.
Tout ce qu'elle a laissé derrière.
Je commence par là."
texte_good = "Une chambre raconte une vie, qui sait lire.
Montrez-moi la sienne.
Je commencerai par savoir qui elle est."
texte_mid = "Les gens laissent toujours quelque chose.
Une chambre, un tiroir, une habitude.
C'est par là qu'on les rattrape."
texte_bof = "Montrez-moi sa chambre.
Ce qu'on garde, ce qu'on jette,
ça parle plus franc que les témoins."
texte_bad = "Montrez-moi sa chambre.
On finit toujours par fouiller les morts.
Ils laissent ça : poussière et mensonges."

[sub_resource type="Resource" id="Rep10"]
script = ExtResource("1")
locuteur = 1
texte = "Venez chez moi quand vous voulez.
Je n'ai touché à rien dans sa chambre.
J'avais peur qu'en rangeant
j'efface le peu qui reste d'elle."

[resource]
script = ExtResource("0")
titre = "Entretien du bureau"
personnages = Array[ExtResource("1_7eb44")]([ExtResource("3"), ExtResource("4")])
repliques = Array[ExtResource("1")]([SubResource("Rep01"), SubResource("Rep02"), SubResource("Rep03"), SubResource("Rep04"), SubResource("Rep05"), SubResource("Rep06"), SubResource("Rep07"), SubResource("Rep08"), SubResource("Rep09"), SubResource("Rep10")])
