[sub_resource type="Resource" id="Choix1"]
script = ExtResource("2")
texte_a = "C'est vous qui avez déchiré la photo."
valeur_a = 5.0
texte_b = "Vous avez déchiré votre fille en deux pour en arracher une autre. Pourquoi ?"
valeur_b = -5.0
texte_c = "..."

[sub_resource type="Resource" id="Rep01"]
script = ExtResource("1")
texte = "Je les ai retrouvées. Luna, et l'autre moitié.
Recollées."

[sub_resource type="Resource" id="Rep02"]
script = ExtResource("1")
locuteur = 1
texte = "(elle prend la photo, ses mains tremblent)
Vous les avez remises ensemble.
Moi, je les avais séparées."
choix = SubResource("Choix1")

[sub_resource type="Resource" id="Rep03"]
script = ExtResource("1")
locuteur = 1
texte = "Oui. C'est moi. Un soir, après son départ,
je n'ai plus supporté de la voir sourire à côté de cette fille.
J'ai arraché Flora. J'ai gardé ma Luna.
Comme si ça pouvait la ramener."
reaction_a = "(un sanglot retenu)
Oui. Je n'ai pas pu garder cette fille chez moi, même en photo.
Alors je l'ai déchirée. Je sais. C'est ridicule."
reaction_b = "Oui, je l'ai déchirée ! C'est ce que vous vouliez entendre ?
J'ai voulu effacer Flora de sa vie.
On n'efface pas les gens en déchirant du papier. Je le sais, maintenant."

[sub_resource type="Resource" id="Rep04"]
script = ExtResource("1")
locuteur = 1
texte = "Flora souriait à tout le monde et ne pensait qu'à elle.
Luna ne voyait pas. Luna ne voyait jamais.
Elle la traînait dans ses histoires, ses dettes, ses mauvais lieux.
Et ma fille suivait, parce qu'elle croyait pouvoir la sauver.
Voilà ce qu'était leur « amitié » : l'une qui prend, l'autre qui se vide."

[sub_resource type="Resource" id="Rep05"]
script = ExtResource("1")
locuteur = 1
texte = "Si vous voulez savoir où est passée ma fille, trouvez d'abord cette fille-là.
Flora. Là où il y a Flora, il y a les ennuis.
Et Luna n'est jamais bien loin des ennuis de Flora."

[sub_resource type="Resource" id="Rep06"]
script = ExtResource("1")
texte = "Alors c'est Flora que je cherche. Et à travers elle, votre fille."
texte_good = "Une fille qui se vide pour en sauver une autre. J'ai connu ça.
On peut peut-être encore la rattraper. Je vais essayer."
texte_bad = "Une qui prend, une qui se vide.
J'ai déjà vu où ça mène. Mais je vais la chercher quand même —
c'est mon métier de remuer la boue des autres."

[resource]
script = ExtResource("0")
titre = "Cuisine — Montrer la photo reconstituée (Luna + Flora)"
personnages = Array[ExtResource("1_7eb44")]([ExtResource("3"), ExtResource("4")])
repliques = Array[ExtResource("1")]([SubResource("Rep01"), SubResource("Rep02"), SubResource("Rep03"), SubResource("Rep04"), SubResource("Rep05"), SubResource("Rep06")])
