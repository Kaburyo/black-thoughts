[sub_resource type="Resource" id="Choix1"]
script = ExtResource("2")
texte_a = "Dans sa chambre. Qui est-ce, madame ?"
valeur_a = 5.0
texte_b = "Dans une poubelle. On ne jette pas les gens qu'on aime. Qui est-ce ?"
valeur_b = -5.0
texte_c = "..."

[sub_resource type="Resource" id="Rep01"]
script = ExtResource("1")
texte = "Cette moitié de photo. Dans la poubelle de sa chambre.
Une jeune renarde — pas Luna.
Quelqu'un a déchiré le cliché en deux, et jeté ce morceau."

[sub_resource type="Resource" id="Rep02"]
script = ExtResource("1")
locuteur = 1
texte = "(son visage se ferme)
Où avez-vous trouvé ça."
choix = SubResource("Choix1")

[sub_resource type="Resource" id="Rep03"]
script = ExtResource("1")
locuteur = 1
texte = "...Flora. Une fille que Luna fréquentait.
Voilà. Ça ne vaut pas la peine d'en parler."
reaction_a = "Une amie de Luna. Flora.
Je préférais qu'elle reste loin de ma fille, c'est tout."
reaction_b = "(elle détourne les yeux)
On ne jette pas ce qu'on aime, non.
C'est sans doute pour ça que cette photo a fini là. Flora. N'insistez pas."

[sub_resource type="Resource" id="Rep04"]
script = ExtResource("1")
locuteur = 1
texte = "Elle a fini dans cette poubelle, et c'est très bien là.
Cette fille n'a jamais rien apporté de bon à Luna.
Quelque chose en elle ne tournait pas rond. Une mère sent ces choses.
Voilà. N'en demandez pas plus."

[sub_resource type="Resource" id="Rep05"]
script = ExtResource("1")
texte = "« Tout ce qu'elle a à dire. »
Les gens disent souvent ça quand ils commencent à peine."
texte_good = "Un nom, c'est déjà une porte. Flora.
Je m'en contenterai. Pour l'instant."
texte_bad = "Une mère qui jette une fille à la poubelle et refuse d'en parler.
Il y a toujours une sale histoire derrière un silence pareil."

[resource]
script = ExtResource("0")
titre = "Cuisine — Montrer Flora (moitié de photo)"
personnages = Array[ExtResource("1_7eb44")]([ExtResource("3"), ExtResource("4")])
repliques = Array[ExtResource("1")]([SubResource("Rep01"), SubResource("Rep02"), SubResource("Rep03"), SubResource("Rep04"), SubResource("Rep05")])
