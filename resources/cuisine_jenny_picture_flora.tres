[sub_resource type="Resource" id="Rep01"]
script = ExtResource("1")
texte = "J'ai trouvé cette moitié de photo.
Dans la poubelle de sa chambre.
Quelqu'un l'a déchirée en deux,
et a jeté ce morceau-là."

[sub_resource type="Resource" id="Choix1"]
script = ExtResource("2")
texte_a = "Qui c'est, madame ?"
valeur_a = 1.0
texte_b = "On jette pas les gens qu'on aime
à la poubelle.
Qui c'est ?"
valeur_b = -2.0
texte_c = "..."

[sub_resource type="Resource" id="Rep02"]
script = ExtResource("1")
locuteur = 1
texte = "... Pourquoi l'avez vous ramassez ?"
choix = SubResource("Choix1")

[sub_resource type="Resource" id="Rep03"]
script = ExtResource("1")
locuteur = 1
reaction_a = "Une amie de Luna. Flora.
Je préférais qu'elle reste loin de ma fille.
C'est tout."
reaction_b = "On ne jette pas ce qu'on aime, non.
C'est sans doute pour ça
que cette photo a fini là."
reaction_c = "Flora.
Une fille que Luna fréquentait.
Ça ne vaut pas la peine d'en parler."

[sub_resource type="Resource" id="Rep04"]
script = ExtResource("1")
locuteur = 1
texte = "Elle a fini dans cette poubelle,
et c'est très bien comme ça.
Cette fille n'a jamais rien apporté de bon à Luna.
Quelque chose en elle ne tournait pas rond.
Une mère sent ces choses."

[sub_resource type="Resource" id="Rep05"]
script = ExtResource("1")
texte = "Un nom, c'est déjà une porte.
Flora.
Je m'en contenterai. Pour l'instant."
texte_bof = "Une mère qui jette une moitié de photo,
et refuse d'en parler.
Y'a toujours une sale histoire derrière."
texte_bad = "Une mère qui balance une photo à la poubelle
et serre les dents quand on demande pourquoi.
Ça pue l'histoire de famille."

[resource]
script = ExtResource("0")
titre = "Cuisine — Montrer Flora (moitié de photo)"
personnages = Array[ExtResource("1_7eb44")]([ExtResource("3"), ExtResource("4")])
repliques = Array[ExtResource("1")]([SubResource("Rep01"), SubResource("Rep02"), SubResource("Rep03"), SubResource("Rep04"), SubResource("Rep05")])
