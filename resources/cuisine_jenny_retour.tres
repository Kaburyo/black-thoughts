[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" uid="uid://byknsokd4a1h0" path="res://resources/conversation.gd" id="0"]
[ext_resource type="Script" uid="uid://c4nqgiisltlk" path="res://resources/replique_dialogue.gd" id="1"]
[ext_resource type="Script" uid="uid://blm8n7fkmbgfp" path="res://resources/personnage_dialogue.gd" id="1_7eb44"]
[ext_resource type="Script" uid="uid://dey7xqbrualto" path="res://resources/choix_dialogue.gd" id="2"]
[ext_resource type="Resource" uid="uid://dskh6uer2righ" path="res://resources/personnage_al.tres" id="3"]
[ext_resource type="Resource" uid="uid://b6s63magyw5ib" path="res://resources/personnage_jenny.tres" id="4"]

[sub_resource type="Resource" id="Choix1"]
script = ExtResource("2")
texte_a = "Un fil, oui.
Je tire dessus, madame."
valeur_a = 5.0
texte_b = "Le ticket. Votre fille fréquentait
des endroits dont vous me parlez pas."
valeur_b = -5.0
texte_c = "..."

[sub_resource type="Resource" id="Rep01"]
script = ExtResource("1")
locuteur = 1
texte = "Vous revoilà.
Le café a tiédi.
Vous avez la tête d'un homme qui a trouvé un fil."
choix = SubResource("Choix1")

[sub_resource type="Resource" id="Rep02"]
script = ExtResource("1")
locuteur = 1
reaction_a = "Tirez doucement.
Un fil mène quelque part.
Ou ça vous serre le cou."
reaction_b = "Ma fille ne traînait pas
dans ces trous-là.
Je connais ma fille."
reaction_c = "Vous vous taisez bien.
Les hommes qui savent quelque chose
se taisent toujours d'abord."

[sub_resource type="Resource" id="Rep03"]
script = ExtResource("1")
locuteur = 1
texte = "Je connais chacune de ses journées.
Le lycée. La bibliothèque. La maison.
...
Le mardi, elle...
Non. Le mardi m'échappe.
Sans importance."

[sub_resource type="Resource" id="Rep04"]
script = ExtResource("1")
locuteur = 1
texte = "Une mère retient tout.
Les premiers mots, les fièvres, les mensonges.
Si j'ai un trou, c'est la fatigue.
Retrouvez-la. Le reste me reviendra."

[resource]
script = ExtResource("0")
titre = "Cuisine — Jenny (retour, après le ticket)"
personnages = Array[ExtResource("1_7eb44")]([ExtResource("3"), ExtResource("4")])
repliques = Array[ExtResource("1")]([SubResource("Rep01"), SubResource("Rep02"), SubResource("Rep03"), SubResource("Rep04")])
